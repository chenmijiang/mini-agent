{
  "name": "mini-agent",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "fmt": "oxfmt",
    "oxlint": "oxlint",
    "start": "node src/index.ts",
    "test": "vitest run",
    "build": "tsdown",
    "prepare": "husky"
  },
  "dependencies": {
    "dotenv": "^18.0.4",
    "openai": "^7.23.0"
  },
  "devDependencies": {
    "@types/node": "^22",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "oxlint-tsgolint": "^7.0.2003",
    "tsdown": "^0.23.0",
    "typescript": "^7",
    "vitest": "^5.0.2"
  },
  "lint-staged": {
    "**/*.{js,ts,json,md}": [
      "oxfmt --no-error-on-unmatched-pattern",
      "oxlint --no-error-on-unmatched-pattern"
    ]
  },
  "engines": {
    "node": ">=22"
  }
}
